#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>




/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  ESC    |  Q  |  W  |  E   |  R  |  V  |    |   |     |     |    |    |    |
// |  TAB    |  A  |  S  |  D   |  F  |  T  |    |   |     |     |    |    |    |
// |  SPC  |  C  |  2  |  1   |     |     |    |   |     |     |    |    |    |
//                   |  G  | I  | LCTRL |             |   |     |     |

                        bindings = <
   &kp ESC   &kp Q  &kp W  &kp E  &kp R   &kp V            &trans  &trans   &trans  &trans  &trans  &trans
   &kp TAB   &kp A  &kp S  &kp D  &kp F   &kp T            &trans  &trans   &trans  &trans  &trans  &trans
   &kp SPC   &kp C  &kp T  &kp N2 &kp N1  &kp LSHFT       &trans  &trans   &trans  &trans  &trans  &trans
                       &kp G  &kp I   &kp LCTRL                      &trans  &trans  &trans
                        >;
                };

        };
};
