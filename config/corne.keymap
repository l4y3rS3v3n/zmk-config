#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ┌─────────┬─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┬────────┐
// │   ESC   │  Q  │  W  │  E  │  R  │  T  │   │  Y  │  U  │  I  │  O  │  P  │  BSPC  │
// ├─────────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼────────┤
// │   TAB   │  A  │  S  │  D  │  F  │  G  │   │  H  │  J  │  K  │  L  │  ;  │   '    │
// ├─────────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼────────┤
// │  SHFT   │  Z  │  X  │  C  │  V  │  B  │   │  N  │  M  │  ,  │  .  │  /  │ RCTRL  │
// └─────────┴─────┴─────┴──┬──┴──┬──┴──┬──┘   └──┬──┴──┬──┴──┬──┴─────┴─────┴────────┘
//                          │LCTRL│ MO1 │SPC│   │ENT│ MO2 │RALT│
//                          └─────┴─────┴───┘   └───┴─────┴────┘
            bindings = <
   &kp ESC   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp TAB   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RCTRL
                   &kp LCTRL &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
            >;
        };

        layer_1 {
// Símbolos + Fn  (hold MO1)
// ┌───────┬─────┬─────┬─────┬─────┬─────┐   ┌──────┬─────┬─────┬─────┬─────┬─────┐
// │ GRAVE │ F1  │ F2  │ F3  │ F4  │ F5  │   │ VOL+ │  (  │  )  │  {  │  }  │ DEL │
// ├───────┼─────┼─────┼─────┼─────┼─────┤   ├──────┼─────┼─────┼─────┼─────┼─────┤
// │  BSPC │ F6  │ F7  │ F8  │ F9  │ F10 │   │ VOL- │  [  │  ]  │  =  │  \  │  |  │
// ├───────┼─────┼─────┼─────┼─────┼─────┤   ├──────┼─────┼─────┼─────┼─────┼─────┤
// │  SHFT │ F11 │ F12 │ F13 │     │ MO3 │   │ MUTE │  -  │  _  │  +  │  <  │  >  │
// └───────┴─────┴─────┴──┬──┴──┬──┴──┬──┘   └──┬───┴──┬──┴──┬──┴─────┴─────┴─────┘
//                        │LALT │     │SPC│   │RET│ MO3 │RALT│
//                        └─────┴─────┴───┘   └───┴─────┴────┘
            bindings = <
   &kp GRAVE  &kp F1  &kp F2  &kp F3  &kp F4 &kp F5   &kp C_VOL_UP &kp LPAR  &kp RPAR  &kp LBRC  &kp RBRC &kp DELETE
   &kp BSPC   &kp F6  &kp F7  &kp F8  &kp F9 &kp F10  &kp C_VOL_DN &kp LBKT  &kp RBKT  &kp EQUAL &kp BSLH &kp PIPE
   &kp LSHFT  &kp F11 &kp F12 &kp F13 &trans &mo 3    &kp C_MUTE   &kp MINUS &kp UNDER &kp PLUS  &kp LT   &kp GT
                      &kp LALT &trans &kp SPACE   &kp RET &mo 3 &kp RALT
            >;
        };

        layer_2 {
// Numpad + Navegação  (hold MO2)
// ┌───────┬─────┬─────┬─────┬─────┬─────┐   ┌─────┬──────┬──────┬───────┬───────┬────────┐
// │  ESC  │  7  │  8  │  9  │  *  │  /  │   │     │ HOME │  UP  │  END  │  INS  │ PSCRN  │
// ├───────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼──────┼──────┼───────┼───────┼────────┤
// │  TAB  │  4  │  5  │  6  │  -  │  +  │   │     │ LEFT │ DOWN │ RIGHT │ PG_UP │  DEL   │
// ├───────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼──────┼──────┼───────┼───────┼────────┤
// │  SHFT │  1  │  2  │  3  │  .  │ MO3 │   │     │  C-← │      │  C-→  │ PG_DN │        │
// └───────┴─────┴─────┴──┬──┴──┬──┴──┬──┘   └──┬──┴──────┴──┬───┴───────┴───────┴────────┘
//                        │LCTRL│  0  │SPC│   │ENT│     │RALT│
//                        └─────┴─────┴───┘   └───┴─────┴────┘
            bindings = <
   &kp ESC   &kp N7 &kp N8 &kp N9 &kp STAR  &kp FSLH   &trans &kp HOME     &kp UP   &kp END       &kp INS   &kp PSCRN
   &kp TAB   &kp N4 &kp N5 &kp N6 &kp MINUS &kp PLUS   &trans &kp LEFT     &kp DOWN &kp RIGHT     &kp PG_UP &kp DELETE
   &kp LSHFT &kp N1 &kp N2 &kp N3 &kp DOT   &mo 3      &trans &kp LC(LEFT) &trans   &kp LC(RIGHT) &kp PG_DN &trans
                    &kp LCTRL &kp N0 &kp SPACE   &kp RET &trans &kp RALT
            >;
        };

        layer_3 {
// Sistema: Bluetooth + Janelas  (MO1 + MO2)
// ┌────────┬──────┬──────┬──────┬──────┬──────┐   ┌─────┬─────────┬──────────┬──────────┬─────┬──────┐
// │ BT_CLR │  BT0 │  BT1 │  BT2 │  BT3 │  BT4 │   │     │         │ NEXT WIN │          │     │ CALC │
// ├────────┼──────┼──────┼──────┼──────┼──────┤   ├─────┼─────────┼──────────┼──────────┼─────┼──────┤
// │        │      │      │      │      │      │   │     │ PREV TAB │ PREV WIN │ NEXT TAB │     │      │
// ├────────┼──────┼──────┼──────┼──────┼──────┤   ├─────┼─────────┼──────────┼──────────┼─────┼──────┤
// │        │      │      │      │      │      │   │     │         │          │          │     │      │
// └────────┴──────┴──────┴──┬───┴──┬───┴──┬───┘   └──┬──┴─────────┴──┬───────┴──────────┴─────┴──────┘
//                           │LCTRL │     │SPC│    │ENT│      │RALT│
//                           └──────┴─────┴───┘    └───┴──────┴────┘
            bindings = <
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans &trans          &kp LA(LS(TAB)) &trans      &trans &kp C_AL_CALC
   &trans     &trans       &trans       &trans       &trans       &trans            &trans &kp LC(LS(TAB)) &kp LA(TAB)     &kp LC(TAB) &trans &trans
   &trans     &trans       &trans       &trans       &trans       &trans            &trans &trans          &trans          &trans      &trans &trans
                           &kp LCTRL &trans &kp SPACE   &kp RET &trans &kp RALT
            >;
        };
    };
};
