#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>




/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3  |  4  |  5  |   |    |     |    |    |    |    |
// |  TAB  |  Q  |  W  |  E  |  R  |  T  |   |    |     |    |    |    |    |
// |  SPC  |  A  |  S  |  D  |  F  |  F1 |   |    |     |    |    |    |    |
//                   |  G  | I  | ESC |  |   |    |     |

                        bindings = <
   &kp ESC &kp 1 &kp 2 &kp 3 &kp 4 &kp 5   &trans  &trans   &trans  &trans  &trans  &trans
   &kp TAB &kp Q &kp W &kp E &kp R &kp T   &trans  &trans   &trans  &trans  &trans  &trans
   &kp SPC &kp A &kp S &kp D &kp F &kp F1  &trans  &trans   &trans  &trans  &trans  &trans
                 &kp G &kp I &kp ESC   &trans  &trans  &trans
                        >;
                };

        };
};
